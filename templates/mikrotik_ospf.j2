# RouterOS 7: explicit managed OSPFv2 instance and backbone
/routing ospf instance add name=tv2-ospf version=2 router-id={{ router_id }}
/routing ospf area add name=tv2-backbone instance=tv2-ospf area-id=0.0.0.0
{% for net in networks %}
/routing ospf interface-template add area=tv2-backbone networks={{ net.prefix }} comment=tv2-ospf-{{ net.prefix | replace('.', '-') | replace('/', '-') }}
{% endfor %}
